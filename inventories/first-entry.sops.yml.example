# Первый вход в ноды — ОБРАЗЕЦ. Настоящий файл: private/inventories/first-entry.sops.yml,
# зашифрован sops + age. Шифруется только password.
#
# Одна карта на весь парк: ни файла на хостера, ни файла на ноду. Признак
# «первый вход пройден» обязан читаться без обращения к ноде, а при файле-на-ноду
# «записи нет» неотличимо от «файл не создан». У одной карты пустота означает
# ровно одно.
#
# СХЕМА
#
#   first_entry:
#     <нода>:
#       user:     <пользователь первого входа>
#       port:     <порт первого входа>
#       method:   password | key
#       password: <sops; только при method: password>
#
# Схема отвечает на два вопроса: ПОД КЕМ открывается дверь и ЧЕМ. Пользователь —
# данность конкретной ноды: root у OVH, непривилегированный с sudo у AWS, GCP,
# Oracle, DigitalOcean. method: key — про ноды, которым ключ кладут при создании;
# у такой записи поля password нет вовсе.
#
# Поля вроде password_expired здесь нет и не будет: просрочен ли пароль, знает
# только нода, и это выясняет make first-contact, читая ответ PTY.
#
# ПРАВИЛА
#
# 1. Запись живёт до первого успешного входа. make first-contact удаляет её,
#    доказав вход ключом парка. Пустая карта читается однозначно: все ноды
#    первый вход прошли.
# 2. У ноды либо есть запись здесь, либо она открывается ключом парка. Третьего
#    нет: отсутствие обоих — отказ с причиной ДО сетевого действия.
# 3. Файл частный и в публичную проекцию не едет никогда.
#
# Пароль вписывается уже в шифротекст:
#   make secrets-edit FILE=private/inventories/first-entry.sops.yml
# Пустое password: "" — признак «ещё не вписан»: sops не шифрует пустую строку,
# поэтому незаполненность видна гейту без ключа расшифровки.
first_entry: {}
