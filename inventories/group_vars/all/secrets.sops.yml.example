# ПЛЕЙСХОЛДЕР. Реальный файл — secrets.sops.yml, ЗАШИФРОВАН sops (см. .sops.yaml).
# Создать: cp this → secrets.sops.yml, заполнить, затем `sops -e -i secrets.sops.yml`.
# Никогда не коммитить расшифрованную версию.
#
# Per-node Reality keypair (`sing-box generate reality-keypair`):
node_example_reality_private_key: "REPLACE"
node_example_reality_short_id: "0123abcd"        # `sing-box generate rand 8 --hex`
#
# Клиенты ноды: name → uuid (только VLESS):
node_example_clients:
  - name: admin
    uuid: "00000000-0000-0000-0000-000000000000"
  - name: laptop
    uuid: "11111111-1111-1111-1111-111111111111"
#
# Hysteria2: отдельный пароль и управляемая self-signed TLS-идентичность.
node_example_hy2_password: "REPLACE_WITH_RANDOM_PASSWORD"
node_example_hy2_certificate: "REPLACE_WITH_PEM_CERTIFICATE"
node_example_hy2_key: "REPLACE_WITH_PEM_PRIVATE_KEY"
node_example_hy2_certificate_public_key_sha256: "REPLACE_WITH_BASE64_SHA256"
