# .export-public.manifest здесь НЕ игнорируется: в этом репозитории он не
# артефакт сборки, а provenance поставки — checksums исходного экспорта.

# Secrets / decrypted
/private/
*.decrypted
*.decrypted.*
.env
.vault_pass.txt
keys.txt
*.age
*.pem
*.key
# Расшифрованные копии частных секретов рядом с шифротекстом
private/**/*.yml.dec
private/**/*.plain

# Working inventories stay local; only the named samples are publishable.
/inventories/*
!/inventories/hosters.yml
!/inventories/first-entry.sops.yml.example
!/inventories/known_hosts.example
!/inventories/nodes/
/inventories/nodes/*
!/inventories/nodes/example.yml.template
!/inventories/group_vars/
/inventories/group_vars/*
!/inventories/group_vars/all/
/inventories/group_vars/all/*
!/inventories/group_vars/all/secrets.sops.yml.example
!/inventories/group_vars/all/ssh_keys.yml.example

# Generated client configs (contain UUIDs)
clients/*
!clients/.gitkeep
# Обезличенные примеры выпускаемых конфигов: форма без чьих-либо координат.
# Реальные выпуски рядом остаются ignored.
!clients/example-client.json
!clients/example-client-legacy.json
!clients/example-client.url

# Ansible
*.retry
/.ansible/
__pycache__/
*.pyc
.ansible_cache/

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
crash.log

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
